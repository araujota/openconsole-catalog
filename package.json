    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.23",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
